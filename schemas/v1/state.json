{
  "models": {
    "StateEvent": {
      "$defs": {
        "StoryState": {
          "enum": [
            "DISCOVERED",
            "CLUSTERED",
            "SCORED",
            "RESEARCHED",
            "VERIFIED",
            "SCRIPTED",
            "RENDERED",
            "AWAITING_APPROVAL",
            "APPROVED_FOR_PUBLISH",
            "PUBLISHED",
            "ANALYZED",
            "NEEDS_RESEARCH",
            "NEEDS_REVISION",
            "REJECTED"
          ],
          "title": "StoryState",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "default": "service",
          "title": "Actor Type",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "from_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoryState"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "manifest_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Hash"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "reason_code": {
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "story_id": {
          "format": "uuid",
          "title": "Story Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "to_state": {
          "$ref": "#/$defs/StoryState"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "run_id",
        "story_id",
        "from_state",
        "to_state",
        "actor_id",
        "reason_code",
        "timestamp",
        "version",
        "input_hash",
        "idempotency_key",
        "operation"
      ],
      "title": "StateEvent",
      "type": "object"
    },
    "StorySnapshot": {
      "$defs": {
        "ArtifactRef": {
          "additionalProperties": false,
          "properties": {
            "media_type": {
              "minLength": 1,
              "title": "Media Type",
              "type": "string"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256",
              "type": "string"
            },
            "size_bytes": {
              "minimum": 0,
              "title": "Size Bytes",
              "type": "integer"
            }
          },
          "required": [
            "sha256",
            "media_type",
            "size_bytes"
          ],
          "title": "ArtifactRef",
          "type": "object"
        },
        "ReviewManifest": {
          "additionalProperties": false,
          "properties": {
            "asset_register": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "attributions": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "captions": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "charts": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "claim_revision_refs": {
              "default": [],
              "items": {
                "$ref": "#/$defs/RevisionRef"
              },
              "title": "Claim Revision Refs",
              "type": "array"
            },
            "dossier": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "internal_label": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Internal Label"
            },
            "kind": {
              "enum": [
                "synthetic_foundation",
                "editorial"
              ],
              "title": "Kind",
              "type": "string"
            },
            "render": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "revision": {
              "minimum": 1,
              "title": "Revision",
              "type": "integer"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "script": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "source_revision_refs": {
              "default": [],
              "items": {
                "$ref": "#/$defs/RevisionRef"
              },
              "title": "Source Revision Refs",
              "type": "array"
            },
            "story_id": {
              "format": "uuid",
              "title": "Story Id",
              "type": "string"
            },
            "subtitles": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "verification": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "story_id",
            "revision",
            "kind",
            "script",
            "dossier",
            "verification",
            "render",
            "subtitles",
            "captions",
            "charts",
            "attributions",
            "asset_register"
          ],
          "title": "ReviewManifest",
          "type": "object"
        },
        "RevisionRef": {
          "additionalProperties": false,
          "properties": {
            "record_id": {
              "format": "uuid",
              "title": "Record Id",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "title": "Revision",
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256",
              "type": "string"
            }
          },
          "required": [
            "record_id",
            "revision",
            "sha256"
          ],
          "title": "RevisionRef",
          "type": "object"
        },
        "StoryState": {
          "enum": [
            "DISCOVERED",
            "CLUSTERED",
            "SCORED",
            "RESEARCHED",
            "VERIFIED",
            "SCRIPTED",
            "RENDERED",
            "AWAITING_APPROVAL",
            "APPROVED_FOR_PUBLISH",
            "PUBLISHED",
            "ANALYZED",
            "NEEDS_RESEARCH",
            "NEEDS_REVISION",
            "REJECTED"
          ],
          "title": "StoryState",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Id"
        },
        "artifacts": {
          "additionalProperties": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "failed_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed Stage"
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewManifest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manifest_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Hash"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "resume_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoryState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/StoryState"
        },
        "story_id": {
          "format": "uuid",
          "title": "Story Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "story_id",
        "run_id",
        "state",
        "version",
        "artifacts"
      ],
      "title": "StorySnapshot",
      "type": "object"
    },
    "TransitionRequest": {
      "$defs": {
        "ArtifactRef": {
          "additionalProperties": false,
          "properties": {
            "media_type": {
              "minLength": 1,
              "title": "Media Type",
              "type": "string"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256",
              "type": "string"
            },
            "size_bytes": {
              "minimum": 0,
              "title": "Size Bytes",
              "type": "integer"
            }
          },
          "required": [
            "sha256",
            "media_type",
            "size_bytes"
          ],
          "title": "ArtifactRef",
          "type": "object"
        },
        "ReviewManifest": {
          "additionalProperties": false,
          "properties": {
            "asset_register": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "attributions": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "captions": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "charts": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "claim_revision_refs": {
              "default": [],
              "items": {
                "$ref": "#/$defs/RevisionRef"
              },
              "title": "Claim Revision Refs",
              "type": "array"
            },
            "dossier": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "internal_label": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Internal Label"
            },
            "kind": {
              "enum": [
                "synthetic_foundation",
                "editorial"
              ],
              "title": "Kind",
              "type": "string"
            },
            "render": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "revision": {
              "minimum": 1,
              "title": "Revision",
              "type": "integer"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "script": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "source_revision_refs": {
              "default": [],
              "items": {
                "$ref": "#/$defs/RevisionRef"
              },
              "title": "Source Revision Refs",
              "type": "array"
            },
            "story_id": {
              "format": "uuid",
              "title": "Story Id",
              "type": "string"
            },
            "subtitles": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "verification": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "story_id",
            "revision",
            "kind",
            "script",
            "dossier",
            "verification",
            "render",
            "subtitles",
            "captions",
            "charts",
            "attributions",
            "asset_register"
          ],
          "title": "ReviewManifest",
          "type": "object"
        },
        "RevisionRef": {
          "additionalProperties": false,
          "properties": {
            "record_id": {
              "format": "uuid",
              "title": "Record Id",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "title": "Revision",
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256",
              "type": "string"
            }
          },
          "required": [
            "record_id",
            "revision",
            "sha256"
          ],
          "title": "RevisionRef",
          "type": "object"
        },
        "StoryState": {
          "enum": [
            "DISCOVERED",
            "CLUSTERED",
            "SCORED",
            "RESEARCHED",
            "VERIFIED",
            "SCRIPTED",
            "RENDERED",
            "AWAITING_APPROVAL",
            "APPROVED_FOR_PUBLISH",
            "PUBLISHED",
            "ANALYZED",
            "NEEDS_RESEARCH",
            "NEEDS_REVISION",
            "REJECTED"
          ],
          "title": "StoryState",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "caller_scope": {
          "minLength": 1,
          "title": "Caller Scope",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewManifest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_code": {
          "default": "stage_complete",
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "story_id": {
          "format": "uuid",
          "title": "Story Id",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/StoryState"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        }
      },
      "required": [
        "story_id",
        "target",
        "expected_version",
        "caller_scope",
        "idempotency_key"
      ],
      "title": "TransitionRequest",
      "type": "object"
    }
  },
  "schema_version": "1.0"
}

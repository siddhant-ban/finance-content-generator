{
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "approve",
        "reject",
        "revise"
      ],
      "title": "Action",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision_id": {
      "format": "uuid",
      "title": "Decision Id",
      "type": "string"
    },
    "expected_version": {
      "minimum": 1,
      "title": "Expected Version",
      "type": "integer"
    },
    "manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "notes": {
      "maxLength": 8000,
      "title": "Notes",
      "type": "string"
    },
    "reviewer_id": {
      "title": "Reviewer Id",
      "type": "integer"
    },
    "reviewer_provider": {
      "title": "Reviewer Provider",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "story_id": {
      "format": "uuid",
      "title": "Story Id",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Trace Id"
    },
    "trace_status": {
      "default": "LEGACY_UNVERIFIED",
      "enum": [
        "RECORDED",
        "DEGRADED",
        "LEGACY_UNVERIFIED"
      ],
      "title": "Trace Status",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "story_id",
    "reviewer_provider",
    "reviewer_id",
    "action",
    "decided_at",
    "manifest_hash",
    "expected_version",
    "notes",
    "trace_id"
  ],
  "title": "HumanDecision",
  "type": "object"
}

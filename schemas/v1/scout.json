      },
      "additionalProperties": false,
      "description": "The immutable artifact read directly by the Novelty consumer.",
      "properties": {
        "cluster_id": {
          "format": "uuid",
          "title": "Cluster Id",
          "type": "string"
        },
        "entities": {
          "items": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Entities",
          "type": "array"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "kind": {
          "const": "editorial",
          "title": "Kind",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/ScoutMember"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "representative": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_id": {
          "const": "scout.candidate.v1",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "story_id": {
          "format": "uuid",
          "title": "Story Id",
          "type": "string"
        },
        "summary": {
          "items": {
            "$ref": "#/$defs/AttributedStatement"

                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Excerpt"
            },
            "locator": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Locator"
            },
            "original_url": {
              "title": "Original Url",
              "type": "string"
            },
            "publication_time_reason": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Publication Time Reason"
            },
            "published_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Published At"
            },
            "publisher": {
              "minLength": 1,
              "title": "Publisher",
              "type": "string"
            },
            "retrieved_at": {
              "format": "date-time",
              "title": "Retrieved At",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "title": "Revision",
              "type": "integer"
            },
            "rights": {
              "enum": [
                "unknown",
                "metadata_only",
                "excerpt_permitted"
              ],
              "title": "Rights",
              "type": "string"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "source_class": {
              "enum": [
                "primary",
                "reputable_secondary",
                "commentary",
                "unknown"
              ],
              "title": "Source Class",
              "type": "string"
            },
            "source_id": {
              "format": "uuid",
              "title": "Source Id",
              "type": "string"
            },
            "usage_notes": {
              "minLength": 1,
              "title": "Usage Notes",
              "type": "string"
            }
          },
          "required": [

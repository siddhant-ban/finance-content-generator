{
  "models": {
    "ScoutEnrichment": {
      "$defs": {
        "AttributedStatement": {
          "additionalProperties": false,
          "properties": {
            "sources": {
              "items": {
                "$ref": "#/$defs/EvidenceRef"
              },
              "maxItems": 1000,
              "minItems": 1,
              "title": "Sources",
              "type": "array"
            },
            "text": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "text",
            "sources"
          ],
          "title": "AttributedStatement",
          "type": "object"
        },
        "EvidenceRef": {
          "additionalProperties": false,
          "properties": {
            "source_id": {
              "format": "uuid",
              "title": "Source Id",
              "type": "string"
            },
            "source_record_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Source Record Hash",
              "type": "string"
            },
            "source_revision": {
              "minimum": 1,
              "title": "Source Revision",
              "type": "integer"
            }
          },
          "required": [
            "source_id",
            "source_revision",
            "source_record_hash"
          ],
          "title": "EvidenceRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "entities": {
          "items": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Entities",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "items": {
            "$ref": "#/$defs/AttributedStatement"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Summary",
          "type": "array"
        },
        "topics": {
          "items": {
            "enum": [
              "prices",
              "jobs",
              "borrowing"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Topics",
          "type": "array"
        },
        "uncertainty": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AttributedStatement"
          },
          "maxItems": 12,
          "title": "Uncertainty",
          "type": "array"
        },
        "warnings": {
          "items": {
            "enum": [
              "seasonally_adjusted",
              "conflicting_sources",
              "revision_possible",
              "limited_coverage"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "summary",
        "topics",
        "entities",
        "warnings"
      ],
      "title": "ScoutEnrichment",
      "type": "object"
    },
    "ScoutFeedItem": {
      "$defs": {
        "SourceRecord": {
          "additionalProperties": false,
          "properties": {
            "canonical_url": {
              "title": "Canonical Url",
              "type": "string"
            },
            "content_hash": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Content Hash"
            },
            "excerpt": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Excerpt"
            },
            "locator": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Locator"
            },
            "original_url": {
              "title": "Original Url",
              "type": "string"
            },
            "publication_time_reason": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Publication Time Reason"
            },
            "published_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Published At"
            },
            "publisher": {
              "minLength": 1,
              "title": "Publisher",
              "type": "string"
            },
            "retrieved_at": {
              "format": "date-time",
              "title": "Retrieved At",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "title": "Revision",
              "type": "integer"
            },
            "rights": {
              "enum": [
                "unknown",
                "metadata_only",
                "excerpt_permitted"
              ],
              "title": "Rights",
              "type": "string"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "source_class": {
              "enum": [
                "primary",
                "reputable_secondary",
                "commentary",
                "unknown"
              ],
              "title": "Source Class",
              "type": "string"
            },
            "source_id": {
              "format": "uuid",
              "title": "Source Id",
              "type": "string"
            },
            "usage_notes": {
              "minLength": 1,
              "title": "Usage Notes",
              "type": "string"
            }
          },
          "required": [
            "source_id",
            "revision",
            "original_url",
            "canonical_url",
            "publisher",
            "source_class",
            "published_at",
            "publication_time_reason",
            "retrieved_at",
            "rights",
            "usage_notes"
          ],
          "title": "SourceRecord",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "headline": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRecord"
        }
      },
      "required": [
        "headline",
        "source"
      ],
      "title": "ScoutFeedItem",
      "type": "object"
    },
    "ScoutRunInput": {
      "$defs": {
        "ScoutConfiguration": {
          "additionalProperties": false,
          "properties": {
            "cluster_version": {
              "minLength": 1,
              "title": "Cluster Version",
              "type": "string"
            },
            "feed_snapshot": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Feed Snapshot",
              "type": "string"
            },
            "model": {
              "minLength": 1,
              "title": "Model",
              "type": "string"
            },
            "prompt_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Prompt Hash",
              "type": "string"
            },
            "prompt_version": {
              "minLength": 1,
              "title": "Prompt Version",
              "type": "string"
            },
            "provider": {
              "minLength": 1,
              "title": "Provider",
              "type": "string"
            },
            "temperature": {
              "maximum": 2,
              "minimum": 0,
              "title": "Temperature",
              "type": "number"
            },
            "version": {
              "minLength": 1,
              "title": "Version",
              "type": "string"
            }
          },
          "required": [
            "version",
            "feed_snapshot",
            "cluster_version",
            "prompt_version",
            "prompt_hash",
            "provider",
            "model",
            "temperature"
          ],
          "title": "ScoutConfiguration",
          "type": "object"
        },
        "ScoutFingerprintSnapshot": {
          "additionalProperties": false,
          "properties": {
            "known": {
              "items": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "title": "Known",
              "type": "array"
            },
            "version": {
              "minLength": 1,
              "title": "Version",
              "type": "string"
            }
          },
          "required": [
            "version",
            "known"
          ],
          "title": "ScoutFingerprintSnapshot",
          "type": "object"
        },
        "ScoutLimits": {
          "additionalProperties": false,
          "properties": {
            "max_items": {
              "maximum": 1000,
              "minimum": 1,
              "title": "Max Items",
              "type": "integer"
            },
            "max_tokens": {
              "maximum": 1000000,
              "minimum": 0,
              "title": "Max Tokens",
              "type": "integer"
            },
            "timeout_seconds": {
              "exclusiveMinimum": 0,
              "maximum": 3600,
              "title": "Timeout Seconds",
              "type": "number"
            }
          },
          "required": [
            "max_items",
            "max_tokens",
            "timeout_seconds"
          ],
          "title": "ScoutLimits",
          "type": "object"
        },
        "ScoutTopicPolicy": {
          "additionalProperties": false,
          "properties": {
            "topics": {
              "items": {
                "enum": [
                  "prices",
                  "jobs",
                  "borrowing"
                ],
                "type": "string"
              },
              "maxItems": 3,
              "minItems": 1,
              "title": "Topics",
              "type": "array"
            },
            "version": {
              "minLength": 1,
              "title": "Version",
              "type": "string"
            }
          },
          "required": [
            "version",
            "topics"
          ],
          "title": "ScoutTopicPolicy",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/ScoutConfiguration"
        },
        "fingerprints": {
          "$ref": "#/$defs/ScoutFingerprintSnapshot"
        },
        "invocation_id": {
          "format": "uuid",
          "title": "Invocation Id",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/ScoutLimits"
        },
        "release_id": {
          "format": "uuid",
          "title": "Release Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "topic_policy": {
          "$ref": "#/$defs/ScoutTopicPolicy"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "invocation_id",
        "window_start",
        "window_end",
        "topic_policy",
        "fingerprints",
        "configuration",
        "release_id",
        "limits"
      ],
      "title": "ScoutRunInput",
      "type": "object"
    },
    "ScoutRunOutput": {
      "$defs": {
        "ArtifactRef": {
          "additionalProperties": false,
          "properties": {
            "media_type": {
              "minLength": 1,
              "title": "Media Type",
              "type": "string"
            },
            "schema_version": {
              "const": "1.0",
              "default": "1.0",
              "title": "Schema Version",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256",
              "type": "string"
            },
            "size_bytes": {
              "minimum": 0,
              "title": "Size Bytes",
              "type": "integer"
            }
          },
          "required": [
            "sha256",
            "media_type",
            "size_bytes"
          ],
          "title": "ArtifactRef",
          "type": "object"
        },
        "ScoutItemDisposition": {
          "additionalProperties": false,
          "properties": {
            "candidate_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArtifactRef"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "item_id": {
              "minLength": 1,
              "title": "Item Id",
              "type": "string"
            },
            "reason": {
              "enum": [
                "candidate_created",
                "known_fingerprint",
                "already_delivered",
                "no_publication_time",
                "outside_window",
                "unknown_rights",
                "invalid_provenance",
                "outside_topic_policy",
                "invalid_enrichment",
                "model_unavailable",
                "model_token_overrun",
                "cluster_failed",
                "revision_conflict",
                "item_limit",
                "token_limit",
                "time_limit"
              ],
              "title": "Reason",
              "type": "string"
            },
            "status": {
              "enum": [
                "new",
                "updated",
                "unchanged",
                "withheld",
                "failed",
                "unprocessed"
              ],
              "title": "Status",
              "type": "string"
            }
          },
          "required": [
            "item_id",
            "status",
            "reason"
          ],
          "title": "ScoutItemDisposition",
          "type": "object"
        },
        "ScoutTokenUsage": {
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "minimum": 0,
              "title": "Input Tokens",
              "type": "integer"
            },
            "output_tokens": {
              "minimum": 0,
              "title": "Output Tokens",
              "type": "integer"
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "title": "ScoutTokenUsage",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Candidates",
          "type": "array"
        },
        "input_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "invocation_id": {
          "format": "uuid",
          "title": "Invocation Id",
          "type": "string"
        },
        "issue": {
          "anyOf": [
            {
              "enum": [
                "feed_unavailable",
                "invalid_feed_batch",
                "cluster_failed",
                "time_limit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ScoutItemDisposition"
          },
          "title": "Items",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "complete",
            "empty",
            "partial",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reported_tokens": {
          "$ref": "#/$defs/ScoutTokenUsage"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trace_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "invocation_id",
        "input_ref",
        "outcome",
        "trace_id",
        "candidates",
        "items",
        "reported_tokens"
      ],
      "title": "ScoutRunOutput",
      "type": "object"
    },
    "StoryCandidate": {

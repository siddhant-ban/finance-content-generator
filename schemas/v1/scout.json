      "required": [
        "schema_version",
        "summary",
        "topics",
        "entities",
        "warnings",
        "schema_id",
        "kind",
        "story_id",
        "cluster_id",
        "revision",
        "fingerprint",
        "representative",
        "members"
      ],
      "title": "StoryCandidate",
      "type": "object"

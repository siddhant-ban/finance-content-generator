            "revision",
            "original_url",
            "canonical_url",
            "publisher",
            "source_class",
            "published_at",
            "publication_time_reason",
            "retrieved_at",
            "rights",
            "usage_notes"
          ],
          "title": "SourceRecord",
          "type": "object"

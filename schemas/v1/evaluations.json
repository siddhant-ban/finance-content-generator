{
  "models": {
    "ComparisonReport": {
      "additionalProperties": false,
      "properties": {
        "baseline_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Hash",
          "type": "string"
        },
        "candidate_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Hash",
          "type": "string"
        },
        "failing_examples": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Failing Examples",
          "type": "array"
        },
        "reason": {
          "enum": [
            "compatible",
            "candidate_failed",
            "not_comparable",
            "invalid_bundle"
          ],
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "candidate_hash",
        "baseline_hash"
      ],
      "title": "ComparisonReport",
      "type": "object"
    },
    "EvalExample": {
      "$defs": {
        "Adjudication": {
          "additionalProperties": false,
          "properties": {
            "confidence": {
              "maximum": 1,
              "minimum": 0,
              "title": "Confidence",
              "type": "number"
            },
            "disagreement_history": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "title": "Disagreement History",
              "type": "array"
            },
            "labeled_at": {
              "format": "date-time",
              "title": "Labeled At",
              "type": "string"
            },
            "labeler": {
              "minLength": 1,
              "title": "Labeler",
              "type": "string"
            },
            "rationale": {
              "minLength": 1,
              "title": "Rationale",
              "type": "string"
            },
            "status": {
              "enum": [
                "fixture_expected",
                "human_adjudicated"
              ],
              "title": "Status",
              "type": "string"
            }
          },
          "required": [
            "status",
            "labeler",
            "labeled_at",
            "rationale",
            "confidence",
            "disagreement_history"
          ],
          "title": "Adjudication",
          "type": "object"
        },
        "FixtureInput": {
          "additionalProperties": false,
          "description": "Trap values are data for a later deterministic fixture stage, not valid evidence.",

        "schema_version",
        "policy_id",
        "agent_name",
        "synthetic_only",
        "required_evaluators",
        "required_splits",
        "contract_pass_rate",
        "policy_pass_rate",
        "critical_false_accepts",
        "rubric_pass_rate"

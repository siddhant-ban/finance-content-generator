            "artifact_version": {
              "minLength": 1,
              "title": "Artifact Version",
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/SyntheticData"
            },
            "metadata_present": {
              "title": "Metadata Present",
              "type": "boolean"
            },
            "reference_ids": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "title": "Reference Ids",
              "type": "array"
            },
            "scenario": {
              "enum": [
                "increment",
                "invalid_reference",
                "state_gate",
                "changed_version",
                "missing_metadata"
              ],
              "title": "Scenario",
              "type": "string"
            },
            "state": {
              "enum": [
                "DRAFT",
                "AWAITING_APPROVAL",
                "APPROVED_FOR_PUBLISH"
              ],
              "title": "State",
              "type": "string"
            }
          },
          "required": [
            "scenario",
            "data",
            "reference_ids",
            "state",
            "artifact_version",
            "metadata_present"
          ],
          "title": "FixtureInput",
          "type": "object"
        },
        "FixtureLabels": {
          "additionalProperties": false,
          "properties": {
            "critical_trap": {
              "title": "Critical Trap",
              "type": "boolean"
            },
            "target_behavior": {
              "enum": [
                "increment",
                "invalid_reference",
                "state_gate",
                "changed_version",
                "missing_metadata"
              ],
              "title": "Target Behavior",
              "type": "string"
            }
          },
          "required": [
            "target_behavior",
            "critical_trap"
          ],
          "title": "FixtureLabels",
          "type": "object"
        },
        "FixtureReference": {
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "enum": [
                "accept",
                "reject"
              ],
              "title": "Outcome",
              "type": "string"
            },
            "output": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SyntheticData"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rejection_code": {
              "anyOf": [
                {
                  "enum": [
                    "increment",
                    "invalid_reference",
                    "state_gate",
                    "changed_version",
                    "missing_metadata"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Rejection Code"
            }
          },
          "required": [
            "outcome",
            "output",
            "rejection_code"
          ],
          "title": "FixtureReference",
          "type": "object"
        },
        "Rights": {
          "additionalProperties": false,
          "properties": {
            "provenance": {
              "minLength": 1,
              "title": "Provenance",
              "type": "string"
            },
            "retention": {
              "minLength": 1,
              "title": "Retention",
              "type": "string"
            },
            "status": {
              "enum": [
                "synthetic_fixture",
                "reviewed_permitted"
              ],
              "title": "Status",
              "type": "string"
            }
          },
          "required": [
            "status",
            "provenance",
            "retention"
          ],
          "title": "Rights",
          "type": "object"
        },
        "SyntheticData": {
          "additionalProperties": false,
          "description": "Strict local arithmetic fixture shared by typed fake provider contracts.",
          "properties": {
            "value": {
              "title": "Value",
              "type": "integer"
            }
          },
          "required": [
            "value"
          ],
          "title": "SyntheticData",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "adjudication": {
          "$ref": "#/$defs/Adjudication"
        },
        "agent_name": {
          "const": "foundation",
          "title": "Agent Name",
          "type": "string"
        },
        "agent_version": {
          "minLength": 1,
          "title": "Agent Version",
          "type": "string"
        },
        "dataset_version": {
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "event_group": {
          "minLength": 1,
          "title": "Event Group",
          "type": "string"
        },
        "evidence_fingerprints": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Fingerprints",
          "type": "array"
        },
        "example_id": {
          "minLength": 1,
          "title": "Example Id",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/FixtureInput"
        },
        "labels": {
          "$ref": "#/$defs/FixtureLabels"
        },
        "reference": {
          "$ref": "#/$defs/FixtureReference"
        },
        "reference_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reference Ids",
          "type": "array"
        },
        "rights": {
          "$ref": "#/$defs/Rights"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "split": {
          "enum": [
            "dev",
            "holdout",
            "prod_regression"
          ],
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "example_id",
        "agent_name",
        "agent_version",
        "dataset_version",
        "split",
        "input",
        "reference",
        "labels",
        "severity",
        "source_refs",
        "reference_ids",
        "event_group",
        "evidence_fingerprints",
        "rights",
        "adjudication"
      ],
      "title": "EvalExample",
      "type": "object"
    },
    "EvalResult": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,

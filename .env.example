# Local configuration only. Copy to ignored .env and load explicitly with uv --env-file .env.
FINANCE_ENVIRONMENT=local
FINANCE_PUBLISHING_ENABLED=false
FINANCE_ALLOW_PAID_PROVIDERS=false
FINANCE_FAKE_STAGE_ENABLED=false
FINANCE_DATA_DIR=data
FINANCE_PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
# Leave model/provider and GitHub credentials unset until their later slices.
# Browser authentication: register your own GitHub OAuth app first.
# FINANCE_GITHUB_CLIENT_ID=
# FINANCE_GITHUB_CLIENT_SECRET=
# Explicit comma-separated numeric GitHub user IDs; no automatic enrollment.
# FINANCE_GITHUB_ALLOWED_IDS=
# Explicitly permit HTTP cookies ONLY on 127.0.0.1:8765 for this trusted local app.
FINANCE_AUTH_LOOPBACK_DEVELOPMENT=false
# Callback is fixed: http://127.0.0.1:8765/auth/github/callback
# Optional read-only Streamlit navigation DB (backend embedding uses the same file).
# FINANCE_REVIEW_DATABASE=data/pipeline.sqlite
